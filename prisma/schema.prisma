generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
    output = "../node_modules/.prisma/client"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  username      String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("atleta") // atleta, coach
  authVersion   Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  profile       AthleteProfile?
  targetRaces   TargetRace[]
  trainingPlans TrainingPlan[]
  workouts      Workout[]
  workoutLogs   WorkoutLog[]
  weightLogs    WeightLog[]
  stravaToken   StravaToken?
  coachMessages CoachMessage[] @relation("AthleteCoachMessages")
}

model CoachMessage {
  id        String   @id @default(cuid())
  userId    String   // atleta destinatario
  coachId   String?  // id do coach que enviou
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation("AthleteCoachMessages", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AthleteProfile {
  id                String   @id @default(cuid())
  userId            String   @unique
  currentWeight     Float?
  heightCm          Float?
  dailyMinutes      Json?
  inactivityWeeks   Int?
  strengthAvailable Boolean?
  targetWeight      Float?
  level             String   @default("intermediario") // iniciante, intermediario, avancado
  modality          String   @default("triatlo") // triatlo, natacao, ciclismo, corrida
  nickname          String?  // apelido exibido na saudacao
  photoUrl          String?  // cloud_storage_path da foto de perfil
  whatsapp          String?  // numero de whatsapp do atleta
  runStructure      String?  // 'zona' | 'distancia' — como estruturar o treino de corrida
  dashboardPrefs    String?  // JSON: preferencias de quais widgets exibir na tela inicial
  aboutMe           String?  // texto livre do atleta exibido na tela inicial
  birthDate         DateTime? // data de nascimento
  sex               String?  // masculino, feminino
  profileCompleted  Boolean  @default(false) // primeiro acesso concluido
  daySchedule       String?  // JSON: modalidades por dia da semana
  bikeEnvByDay      String?  // JSON: {dia: 'rolo'|'rua'} cenario do ciclismo por dia
  runEnvByDay       String?  // JSON: {dia: 'esteira'|'rua'} cenario da corrida por dia
  availableDays     String[] // ["seg","ter","qua","qui","sex","sab","dom"]
  limitations       String?
  ftp               Float?
  vo2max            Float?
  maxHeartRate      Int?
  restingHeartRate  Int?
  thresholdHeartRate Int?
  runThresholdPace  String?
  swimCssPace       String?
  recentRaceDistanceKm Float?
  recentRaceTimeSeconds Int?
  recentRaceDate    DateTime?
  swimPace          String?  // pace por 100m
  runPace           String?  // pace por km
  raceHistory       String?  // texto livre
  // === Coach Assessment Fields ===
  trainingYears     Int?     // anos de experiência em triathlon
  weeklyHours       Float?   // horas semanais disponíveis
  currentWeeklyVol  Float?   // volume semanal atual (horas)
  swimLevel         String?  // nenhuma, basico, intermediario, avancado
  bikeLevel         String?  // iniciante, intermediario, avancado
  runLevel          String?  // iniciante, intermediario, avancado
  weakestSport      String?  // natacao, ciclismo, corrida
  strongestSport    String?  // natacao, ciclismo, corrida
  goalType          String?  // completar, melhorar_tempo, competir, top_age_group
  goalTime          String?  // tempo-alvo se aplicável
  injuryHistory     String?  // histórico detalhado de lesões
  currentInjuries   String?  // lesões atuais
  medicalConditions String?  // condições médicas relevantes
  sleepHours        Float?   // horas de sono por noite
  stressLevel       String?  // baixo, moderado, alto
  hasPoolAccess     Boolean  @default(true)
  poolSize          String?  // 25m, 50m, mar_aberto
  hasTrainer        Boolean  @default(false)  // rolo/trainer indoor
  hasPowerMeter     Boolean  @default(false)
  hasHRM            Boolean  @default(true)   // frequencímetro
  bikeType          String?  // speed, tt, mtt, gravel
  dietaryNotes      String?  // restrições alimentares
  workSchedule      String?  // flexivel, fixo_comercial, turnos, remoto
  travelFrequency   String?  // raro, mensal, semanal
  previousPlanExp   String?  // nunca, basico, estruturado
  // === Testes Físicos ===
  testCSS400        String?  // tempo 400m natação (mm:ss)
  testCSS200        String?  // tempo 200m natação (mm:ss)
  testCSSPace       String?  // CSS calculado (mm:ss/100m)
  testFTP20min      Float?   // potência média 20min (watts)
  testFTPEstimated  Float?   // FTP estimado (x0.95)
  testFTPHR         Int?     // FC média no teste FTP
  testRun30min      Float?   // distância em 30min (km)
  testRunPace       String?  // pace limiar corrida
  testRunHR         Int?     // FC média no teste corrida
  testRun3km        String?  // tempo 3km (mm:ss)
  canSwim           Boolean  @default(true)
  testsCompleted    Boolean  @default(false)
  coachAssessmentDone Boolean @default(false)
  intervalsIcuApiKey String?  // chave de API do Intervals.icu para envio direto de treinos ao calendario
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TargetRace {
  id        String   @id @default(cuid())
  userId    String
  name      String
  date      DateTime
  distance  String   // sprint, olimpico, 70.3, ironman
  priority  String?  // A: principal; B/C: secundária
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
}

model TrainingPlan {
  id          String   @id @default(cuid())
  userId      String
  name        String
  startDate   DateTime
  endDate     DateTime
  raceId      String?
  status      String   @default("active") // active, archived
  generatedBy String   @default("ai") // ai, manual
  nutritionPlan String? // plano nutricional em texto/markdown
  summary     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workouts    Workout[]

  @@index([userId])
  @@index([status])
}

model Workout {
  id             String       @id @default(cuid())
  userId         String
  planId         String?
  date           DateTime
  modality       String       // natacao, ciclismo, corrida, forca, descanso
  title          String
  description    String
  structure      Json?
  duration       Int          // minutos
  targetZone     String?      // Z1, Z2, Z3, Z4, Z5
  tssEstimate    Float?       // estimativa de carga
  phase          String?      // base, construcao, pico, polimento
  weekNumber     Int?
  completed      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan           TrainingPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  log            WorkoutLog?

  @@index([userId])
  @@index([planId])
  @@index([date])
  @@index([modality])
}

model WorkoutLog {
  id              String   @id @default(cuid())
  workoutId       String   @unique
  userId          String
  actualDuration  Int?     // minutos
  actualDistance  Float?   // km
  rpe             Int?     // 1-10
  weight          Float?
  heartRateAvg    Int?
  sleepHours      Float?
  fatigueScore    Int?
  painScore       Int?
  notes           String?
  stravaActivityId String?
  completedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  workout         Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([completedAt])
}

model WeightLog {
  id        String   @id @default(cuid())
  userId    String
  weight    Float
  date      DateTime @default(now())
  notes     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([date])
}

model StravaToken {
  id            String   @id @default(cuid())
  userId        String   @unique
  accessToken   String
  refreshToken  String
  expiresAt     Int
  athleteId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
