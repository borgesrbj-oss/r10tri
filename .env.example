# Banco PostgreSQL de desenvolvimento. Preencha localmente, sem versionar credenciais.
DATABASE_URL=

# Gere localmente com: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Alias legado opcional; se preenchido, use o mesmo segredo de AUTH_SECRET.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
MOBILE_DEEP_LINK_SCHEMES=
MOBILE_PREVIEW_ORIGINS=

# Integrações opcionais. Não são necessárias para o motor determinístico de planos.
ABACUSAI_API_KEY=
WEB_APP_ID=
NOTIF_ID_BOASVINDAS_AO_ATLETA=
AWS_PROFILE=
AWS_REGION=
AWS_BUCKET_NAME=
AWS_FOLDER_PREFIX=

# Criação explícita e opcional de conta inicial; não sobrescreve contas existentes.
SEED_EMAIL=
SEED_PASSWORD=
SEED_ROLE=coach
SEED_NAME=
SEED_USERNAME=

# Recuperação de senha: conta SMTP autenticada com TLS, sem credenciais no Git.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false

# Criação inicial opcional na hospedagem; hash bcrypt privado, nunca uma senha padrão.
BOOTSTRAP_COACH_EMAIL=
BOOTSTRAP_COACH_USERNAME=
BOOTSTRAP_COACH_PASSWORD_HASH=
BOOTSTRAP_COACH_NAME=

# Opções de desenvolvimento/compilação.
DEV_ALLOWED_ORIGINS=
NEXT_DIST_DIR=.next
NEXT_OUTPUT_MODE=
AUTH_SMOKE_BASE=http://localhost:3000
INTEGRATION_SMOKE_BASE=http://localhost:3000
PORT=3000
